# RCO Ψ-V5.1.0 Repository Filter
# Ensures Forensic Purity by excluding transient build artifacts

# --- Sovereign Distribution (DO NOT IGNORE) ---
!dist/
!dist/manifest.json
!dist/lib/librco_core.so
!dist/include/rco-core.h

# --- Rust / Native ---
target/
Cargo.lock
debug/
release/

# --- Java SDK ---
*.class
*.jar
*.war
bindings/java/com/rco/*.class

# --- Node.js SDK ---
node_modules/
npm-debug.log
bindings/node/build/
bindings/node/index.node

# --- C# SDK ---
bindings/csharp/bin/
bindings/csharp/obj/

# --- Python / Ruby / PHP ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
bindings/ruby/.bundle/

# --- Julia ---
*.jl.cov
*.jl.mem

# --- Installer Staging ---
release_staging/
staging.*/
.cache/rco_manifold/

# --- IDE & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.env
.history/
